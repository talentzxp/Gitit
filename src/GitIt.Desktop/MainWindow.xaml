<Window x:Class="GitIt.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GitIt — 文档版本考古" Width="1420" Height="860" MinWidth="1050" MinHeight="650"
        Background="#F7F8FA" AllowDrop="True" Drop="DropArea_Drop" DragOver="DropArea_DragOver">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <DockPanel Grid.Row="0" Background="White" Margin="0,0,0,1" LastChildFill="False">
      <StackPanel Orientation="Vertical" Margin="20,14" DockPanel.Dock="Left">
        <TextBlock Text="GitIt" FontSize="23" FontWeight="SemiBold" />
        <TextBlock Text="看清文件从哪里来、谁改过、改了什么。" Foreground="#5D6570" />
      </StackPanel>
      <Button DockPanel.Dock="Right" Margin="12" Padding="16,9" Click="ChooseFolder_Click" Content="选择文件夹" />
    </DockPanel>

    <Border Grid.Row="1" Margin="12,10,12,0" Padding="12" CornerRadius="5" BorderBrush="#C8D5E5" BorderThickness="1" Background="#EEF6FF">
      <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap" />
    </Border>

    <Grid Grid.Row="2" Margin="12" AllowDrop="True" Drop="DropArea_Drop" DragOver="DropArea_DragOver">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="250" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="350" />
      </Grid.ColumnDefinitions>

      <Border Grid.Column="0" Background="White" BorderBrush="#DCE1E8" BorderThickness="1" Padding="12">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top" Text="文档家族" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8" />
          <ListBox ItemsSource="{Binding Families}" SelectedItem="{Binding SelectedFamily}" BorderThickness="0">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <StackPanel Margin="4,7">
                  <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                  <TextBlock Text="{Binding Kind}" Foreground="#57606A" FontSize="12" />
                  <TextBlock Text="{Binding Summary}" Foreground="#57606A" FontSize="12" TextWrapping="Wrap" />
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>
      </Border>

      <Border Grid.Column="1" Background="White" BorderBrush="#DCE1E8" BorderThickness="1" Padding="12" Margin="10,0">
        <TabControl>
          <TabItem Header="版本血缘">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="160" />
              </Grid.RowDefinitions>
              <ScrollViewer Grid.Row="0" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                <Canvas Width="920" Height="500" Background="#FCFCFD">
                  <ItemsControl ItemsSource="{Binding GraphEdges}">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><Canvas /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Line X1="{Binding X1}" Y1="{Binding Y1}" X2="{Binding X2}" Y2="{Binding Y2}" Stroke="#426B9B" StrokeThickness="2">
                          <Line.Style>
                            <Style TargetType="Line">
                              <Style.Triggers>
                                <DataTrigger Binding="{Binding IsStrong}" Value="False"><Setter Property="StrokeDashArray" Value="4,3" /></DataTrigger>
                              </Style.Triggers>
                            </Style>
                          </Line.Style>
                        </Line>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <ItemsControl ItemsSource="{Binding GraphNodes}">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><Canvas /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemContainerStyle>
                      <Style TargetType="ContentPresenter"><Setter Property="Canvas.Left" Value="{Binding X}" /><Setter Property="Canvas.Top" Value="{Binding Y}" /></Style>
                    </ItemsControl.ItemContainerStyle>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Button Command="{Binding DataContext.SelectNodeCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Width="160" MinHeight="58" Padding="6" HorizontalContentAlignment="Left">
                          <StackPanel>
                            <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding Status}" FontSize="11" Foreground="#59636E" />
                          </StackPanel>
                        </Button>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <TextBlock Text="拖入一个包含 Word、Excel 或 PowerPoint 文件的文件夹开始分析" FontSize="16" Foreground="#667085" Visibility="{Binding HasAnalysis, Converter={StaticResource InverseBooleanToVisibilityConverter}}" />
                </Canvas>
              </ScrollViewer>
              <Border Grid.Row="1" BorderBrush="#E4E7EC" BorderThickness="0,1,0,0" Padding="8">
                <DockPanel>
                  <TextBlock DockPanel.Dock="Top" Text="关系（点击查看改动）" FontWeight="SemiBold" />
                  <ListBox ItemsSource="{Binding EdgeList}" BorderThickness="0">
                    <ListBox.ItemTemplate>
                      <DataTemplate>
                        <Button Command="{Binding DataContext.SelectEdgeCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" HorizontalContentAlignment="Left" Margin="0,2">
                          <TextBlock Text="{Binding Label}" />
                        </Button>
                      </DataTemplate>
                    </ListBox.ItemTemplate>
                  </ListBox>
                </DockPanel>
              </Border>
            </Grid>
          </TabItem>
          <TabItem Header="参与者">
            <Grid Margin="8">
              <Grid.ColumnDefinitions><ColumnDefinition Width="260" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
              <ListBox Grid.Column="0" ItemsSource="{Binding Participants}" SelectedItem="{Binding SelectedParticipant}">
                <ListBox.ItemTemplate><DataTemplate><StackPanel Margin="4,7"><TextBlock Text="{Binding Name}" FontWeight="SemiBold" /><TextBlock Text="{Binding Summary}" Foreground="#59636E" FontSize="12" /></StackPanel></DataTemplate></ListBox.ItemTemplate>
              </ListBox>
              <TextBlock Grid.Column="1" Margin="16" Text="选择参与者以查看其 Office 证据。身份字符串并非经过认证的真实身份。" Foreground="#59636E" TextWrapping="Wrap" />
            </Grid>
          </TabItem>
        </TabControl>
      </Border>

      <Border Grid.Column="2" Background="White" BorderBrush="#DCE1E8" BorderThickness="1" Padding="12">
        <DockPanel>
          <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="详情" FontSize="16" FontWeight="SemiBold" />
            <TextBlock Text="{Binding DetailTitle}" FontWeight="SemiBold" Margin="0,9,0,2" TextWrapping="Wrap" />
            <TextBlock Text="{Binding DetailSubtitle}" Foreground="#59636E" TextWrapping="Wrap" />
          </StackPanel>
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,12,0,0">
              <TextBlock Text="证据与改动" FontWeight="SemiBold" />
              <ItemsControl ItemsSource="{Binding DetailLines}"><ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,3" /></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
              <Expander Header="测试信息" Margin="0,12,0,0">
                <ItemsControl ItemsSource="{Binding TestLines}"><ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,3" FontFamily="Consolas" FontSize="11" /></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
              </Expander>
              <Expander Header="警告与未支持内容" IsExpanded="True" Margin="0,12,0,0">
                <ItemsControl ItemsSource="{Binding Warnings}"><ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap" Foreground="#9B3A1B" Margin="0,3" /></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
              </Expander>
            </StackPanel>
          </ScrollViewer>
        </DockPanel>
      </Border>
    </Grid>
  </Grid>
</Window>
